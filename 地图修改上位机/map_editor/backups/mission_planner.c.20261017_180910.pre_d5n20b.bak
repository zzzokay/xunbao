/*
 * mission_planner.c - 任务规划器
 *
 * 职责：根据比赛规则（QR码、门颜色、宝物位置）动态决定路线
 *
 * 数据依赖：
 *   - 全局状态：door_pass[], treasure, flag_line_clue, flag_clue_stage_A/B
 *   - 地图数据：route[], nodes, map (from map.h)
 *   - 预定义路线：door*route[] (from map.c)
 *
 * 调用关系：
 *   barrier.c (door/Stage等) → mission_planner (本模块) → nav_planner (最短路算法)
 */

#include "mission_planner.h"
#include "map.h"
#include "nav_planner.h"
#include "chassis_api.h"
#include "barrier.h"
#include "task_create.h"      /* xTaskGetTickCount/configTICK_RATE_HZ（比赛计时器） */
#include "stdio.h"

/* ==================== 外部依赖 ==================== */
extern uint8_t door_pass[5];              // 门通行状态（barrier.c）
extern uint8_t treasure;                  // 宝物平台编号（barrier.c）
extern volatile uint8_t flag_line_clue;   // QR百位（barrier.c）
extern volatile uint8_t flag_clue_stage_A;// QR十位（barrier.c）
extern volatile uint8_t flag_clue_stage_B;// QR个位（barrier.c）
extern u8 route[100];                     // 全局路线数组（map.c）
extern Nodes nodes;                       // 当前节点状态（map.c）
extern struct Map_State map;              // 地图状态（map.c）

/* 门操作函数（barrier.c）*/
extern NODE door_set_pass_node(uint8_t a, uint8_t b, uint16_t step, float speed);

/* ==================== 门回程：仍保留的手写路线 ==================== */
/* D2 关 + D3 关 时"从 N4 去撞 D4 读灯"（barrier.c 的 DOOR_D3 NO_PASS 分支加载）。
   它是"去下一扇门"而非回程，且只有 2 个节点，故未纳入下面 route_return_home() 的规划器方案。 */
u8 door1route[100] = {N3, N8, 0XFF};                     // D2关D3关，去D4

/* ==================== 门区边表（规划层禁用用） ==================== */
/* 门区 8 条通行边（4 对 × 2 方向），与 Clear_door() 操作的是同一组边。
   回程时全部禁用，防止最短路又拐回门区、或在门口穿门掉头。 */
static const u8 door_zone[8][2] = {
	{N5, N12}, {N12, N5}, {N5, N8}, {N8, N5},
	{N3, N8},  {N8, N3},  {N3, N20}, {N20, N3},   /* D5 过门边 10-17: N10→N3 改 N20→N3 */
};

/* ==================== 内部辅助函数 ==================== */

/**
 * @brief 加载路线到 route[] 指定位置
 * @param offset 起始偏移量
 * @param src 源路线数组（以 0xFF 结尾）
 */
void load_route_at(uint8_t offset, const u8* src)
{
	for(uint8_t i = 0; i < 50; i++)
	{
		route[offset + i] = src[i];
		if(src[i] == 0xFF)
			break;
	}
}

/**
 * @brief 使用规划器生成路线并写入 route[]
 * @param offset route[] 起始偏移
 * @param waypoints 必经点数组
 * @param waypoint_count 必经点数量
 * @return 1=成功, 0=失败(已 CarBrake_Stop)
 * @note  不受 USE_PLANNER_ROUTE 开关影响：门回程（route_return_home）恒用规划器，
 *        因为穷举数组正是"规划器不知道哪扇门能过"的产物，见 _check_door_perm.py。
 */
static uint8_t plan_route_at(uint8_t offset, const u8 *waypoints, uint8_t waypoint_count)
{
	uint8_t written;

	if (offset >= sizeof(route))
	{
		printf("[HARD-STOP] mp:plan_route_at offset overflow\r\n");
		CarBrake_Stop();
		return 0;
	}

	written = nav_build_route(&route[offset], (uint8_t)(sizeof(route) - offset),
		waypoints, waypoint_count);
	if (written == 0)
	{
		route[offset] = 0xFF;
		printf("[HARD-STOP] mp:plan_route_at no path found\r\n");
		CarBrake_Stop();
		return 0;
	}
	return 1;
}

/**
 * @brief 一轮回程中"宝物平台之后、P2 之前"的那一段：交错安排补打卡 P3/P4 与直立景点 S1/S2
 * @param wp 必经点数组（调用方已写入宝物平台等前段）
 * @param n  当前已填数量
 * @return 追加后的 n
 * @note  2026-10-07 起 S1/S2 的判据**跟着"这次回程会不会去 P3/P4"走**，不再看宝物值：
 *          会去 P3 = 宝物平台就是 P3，或 补打卡开着且 QR 百位没走过 P3；会去 P4 同理。
 *          ⇒ 补打卡开着时两个景点都绕（3/4 都去）；关掉补打卡自动退回旧行为
 *            （宝物 P3→S1、P4→S2）。
 *        基础序 P3 -> S1 -> P4 -> S2；宝物=4 时尾段按沿途岔口重排 S2 -> P3 -> S1。
 *        ⚠️ 景点与平台一律在拿完宝藏之后（2026-10-11 确认规则）。
 *        ⚠️ 必须在宝物平台【之后】调用：取宝之前去任何平台 = 走错即结束比赛。
 *        ⚠️ 宝物平台本身（treasure==3/4）由调用方在其前面已加，这里只补另一个。
 */
/* 宝物=4：宝物平台（P4，N6 岔口）之后按沿途岔口顺序
 * S2（N6，出平台顺便）→ P3 → S1（N3 岔口，回头补）。
 * ⚠️ 景点 S1/S2 也必须在拿完宝藏之后（2026-10-11 用户确认规则），
 *    不能再提前到宝物前；这里只在宝物后重排。 */
/* ==================== 比赛时间预算（出门分级贪分，2026-10-11） ====================
 * 计时起点 = zhunbei() 两个红外 while 退出（Match_Timer_Start，一/二轮各一次 → 各自 180s）。
 * 出门（回程到达 N3/N5，即本函数被调的时刻）已用时分级：
 *   < 2:25 全跑（含 S1/S2）；≥ 2:25 不跑 S1/S2；≥ 2:35 只跑一个平台；≥ 2:40 直接回家。
 * 阈值在 config.h 的 TB_*；裁剪顺序 S1 → S2 →（不够再裁）补打卡平台。 */
uint32_t match_start_tick = 0;   /* 0 = 未启动（视为时间充足，保护调试路径） */

void Match_Timer_Start(void)
{
	/* 两个功能（分级贪分 / 硬截止回家）任一需要计时就启动；都为 0 时与加"硬截止"之前一字不差 */
	if (!TIME_BUDGET_ENABLE && !TB_FORCE_HOME_ENABLE) return;
	match_start_tick = xTaskGetTickCount();
}

uint32_t Match_Elapsed_S(void)
{
	if (match_start_tick == 0) return 0;
	return (xTaskGetTickCount() - match_start_tick) / configTICK_RATE_HZ;   /* 秒：1000Hz ⇒ 必须 /1000 */
}

/* 尾段档位 */
enum { TB_ALL = 0, TB_NO_SIGHTS, TB_ONE_PLAT, TB_HOME_ONLY };

static uint8_t round1_tail_tier_of(uint32_t exit_elapsed_s)
{
	/* 唯一调用方 = round1_exit_recheck()（宝物=P1 时在 P1 取完宝那一刻，其余在到达 N3/N5 那一刻）。
	 * TIME_BUDGET_ENABLE=0 时恒返 TB_ALL（全量尾段，即无时间预算行为）。 */
	if (!TIME_BUDGET_ENABLE) return TB_ALL;
	if (treasure == 2) {                         /* 宝物在 P1：收景点提前到 2:15、2:25 就回家 */
		if (exit_elapsed_s < TB_P1_NO_SIGHTS_AT_S)  return TB_ALL;
		if (exit_elapsed_s < TB_P1_HOME_ONLY_AT_S)  return TB_NO_SIGHTS;
		return TB_HOME_ONLY;
	}
	if (exit_elapsed_s < TB_NO_SIGHTS_AT_S)  return TB_ALL;
	if (exit_elapsed_s < TB_ONE_PLAT_AT_S)   return TB_NO_SIGHTS;
	if (exit_elapsed_s < TB_HOME_ONLY_AT_S)  return TB_ONE_PLAT;
	return TB_HOME_ONLY;
}

/* 前置声明：round1_exit_recheck 用到（本体在后） */
static uint8_t append_round1_return_tail(u8 *wp, uint8_t n, uint8_t tier, uint8_t exit_n3);
static void door_block_all(void);

static uint8_t s_exit_checked = 0;   /* 本轮是否已定档（宝物=P1 在 P1、其余在出门边；get_newroute 复位） */
static uint8_t s_home_forced = 0;    /* 本轮硬截止是否已接管路线（TB_FORCE_HOME_ENABLE；get_newroute 复位） */

/* 出门定档检查站（时间预算的唯一决策点，2026-10-12）：
 * 一轮完成出门边（N10→N3 / N8→N3 / N12→N5 / N8→N5）、
 * 到达 N3/N5 节点那一刻，用真实已用时+惩罚给尾段定档并重写后续路线。
 * 无论回程走 door() BACK（D5/D4 首读）还是绿灯穿门（门边
 * func=NONE，door() 不触发），都会在这里汇合——前者的预案被覆盖，
 * 后者完全靠这里。每轮只做一次（s_exit_checked）。
 * 由 Nav_TurnAndAdvance() 入口 + barrier.c 的 Stage()（宝物=P1，取完宝后）调用。 */
void round1_exit_recheck(void)
{
	u8 wp[8];
	uint8_t n = 0;
	uint8_t i;
	u8 arr = nodes.nowNode.nodenum;    /* 刚到达的节点（当前边的目标） */
	u8 from = nodes.lastNode.nodenum;  /* 门的另一侧节点 */

	if (!TIME_BUDGET_ENABLE) return;
	if (map.routetime != 0) return;         /* 只管一轮（二轮=2） */
	if (s_exit_checked) return;
	/* 定档点：宝物=P1 → 在 P1 平台（Stage() 调）；其余 → 到达四条出门边（去程不会误触发） */
	if (treasure == 2) { if (arr != P1) return; }
	else if (!((arr == N3 && (from == N10 || from == N8)) ||
	           (arr == N5 && (from == N12 || from == N8)))) return;

	/* 前方还有可选加分项（S1/S2/补打卡平台）才值得重排 */
	{
		uint8_t has_opt = 0;
		for (i = map.point; i < (u8)sizeof(route) && route[i] != 0xFF; i++) {
			if (route[i] == S1 || route[i] == S2
				|| (route[i] == P3 && treasure != 3)
				|| (route[i] == P4 && treasure != 4)) { has_opt = 1; break; }
		}
		if (!has_opt) { s_exit_checked = 1; return; }
	}

	door_block_all();   /* 与 route_return_home 同口径：门区不再进 */
	wp[n++] = arr;
	if (treasure == 2)       { if (arr != P1) wp[n++] = P1; }   /* 宝物=P1 时 arr 就是 P1 */
	else if (treasure == 3)  wp[n++] = P3;
	else if (treasure == 4)  wp[n++] = P4;
	n = append_round1_return_tail(wp, n,
		round1_tail_tier_of(Match_Elapsed_S()),
		(treasure == 2) ? 1 : (arr == N3));   /* P1 之后先西(P3)后东(P4) */
	wp[n++] = P2;
	/* 交接同 plan_treasure_return：从 route[point-1] 起重写，并把 nextNode 
	 * 对齐到新路线的第一跳（推进随后正常进行） */
	if (plan_route_at(map.point - 1, wp, n)) {
		u8 first = route[map.point - 1];
		if (first != 0xFF)
			nodes.nextNode = Node[getNextConnectNode(arr, first)];
	}
	s_exit_checked = 1;
}

/* 硬截止：到点强制回家（2026-10-16，受 config.h 的 TB_FORCE_HOME_ENABLE 门控）
 * 只要「已用时 ≥ TB_GO_HOME_AT_S」，无论当前节点在哪、正在做什么，剩下的路线立刻压成
 *   [当前节点, P2] —— 放弃补打卡 P3/P4、放弃景点 S1/S2，必要时连宝物平台也不去。
 * 只在「车已出门」时接管：判据 = 门区 8 条边全禁掉之后，还能不能到 P2。
 *   能到（= 门西侧那 14 个节点 B1/B2/B3/N1~N6/P1/P3/P4/S1/S2）→ 重排 [当前, P2]；
 *   到不了（= 门东侧，含门区自身）→ 不接管：穿门回家得靠 door() 状态机（读灯/退回/重读），
 *   临时另写一条穿门路线风险更大，而车本来也正朝门走 —— 出门那一刻
 *   round1_exit_recheck() 会接管（它已有自己的「直接回家」档）。
 * ⚠️ 探针用 nav_shortest_path()：它**不触发停车**（plan_route_at 失败会 CarBrake_Stop），
 *    且严格吃 s_blocked，返回 0 **当且仅当真不可达**（缓冲写满只是截断、仍返回 >0）。
 * ⚠️ 探针失败时门区保持禁用（与回程腿同口径）：之后需要穿门的都是门区自身的 door() 分支，
 *    它们本来就会再禁一次；这里不解禁，免得给后续规划重新打开一条穿门路。
 * ⚠️ 开关走**入参** enable（调用方传 TB_FORCE_HOME_ENABLE），不在函数里判宏 ——
 *    宏=0 时编译器会把 `if (!宏) return;` 常量折叠，后面整段变「不可达」报 #111-D；
 *    项目又规定开关门控不用 #if（见 README §2.14）。enable=0 时等于没这个函数。
 * ⚠️ 必须在 round1_exit_recheck() 之后调用：到点时它要覆盖那边刚定好的档。 */
void round_force_home_check(uint8_t enable)
{
	u8 probe[12];   /* 只判"是不是 0"：西侧到 P2 最长 7 个节点，截断也不影响判定 */
	u8 wp[2];
	u8 now = nodes.nowNode.nodenum;

	if (!enable) return;                               /* 总开关关：完全不动（默认） */
	if (s_home_forced) return;                         /* 本轮已接管过 */
	if (Match_Elapsed_S() < TB_GO_HOME_AT_S) return;   /* 还没到点 */
	if (now == P2) { s_home_forced = 1; return; }      /* 已在家 */

	door_block_all();
	if (nav_shortest_path(now, P2, probe, (u8)sizeof(probe)) == 0) return;  /* 门东侧：不接管 */

	wp[0] = now;
	wp[1] = P2;
	if (plan_route_at(map.point - 1, wp, 2)) {
		u8 first = route[map.point - 1];
		if (first != 0xFF)
			nodes.nextNode = Node[getNextConnectNode(now, first)];
	}
	s_home_forced = 1;
}

static uint8_t append_round1_return_tail(u8 *wp, uint8_t n, uint8_t tier, uint8_t exit_n3)
{
	uint8_t goP3 = (treasure == 3) ||
		(P3P4_PUNCH_ENABLE && flag_line_clue != 3 && treasure != 3);
	uint8_t goP4 = (treasure == 4) ||
		(P3P4_PUNCH_ENABLE && flag_line_clue != 4 && treasure != 4);
	/* tier 由调用方按出门时刻算好传入（route_return_home / plan_treasure_return） */
	/* exit_n3 由调用方显式传入（出门节点是否 N3） */

	if (tier == TB_HOME_ONLY)   return n;               /* ≥2:40 直接回家 */

	if (tier == TB_ONE_PLAT) {                          /* ≥2:35 只跑一个平台 */
		/* 出门 N3 选 P3（就近）；其余出门选 P4（在前方顺路） */
		if (exit_n3) {
			if (goP3 && treasure != 3) { wp[n++] = P3; return n; }
			if (goP4 && treasure != 4) { wp[n++] = P4; return n; }
			return n;
		}
		if (goP4 && treasure != 4) { wp[n++] = P4; return n; }
		if (goP3 && treasure != 3) { wp[n++] = P3; return n; }
		return n;
	}

	if (tier == TB_NO_SIGHTS) {                         /* ≥2:25 不跑 S1/S2 */
		if (exit_n3) {
			if (goP3 && treasure != 3) wp[n++] = P3;
			if (goP4 && treasure != 4) wp[n++] = P4;
			return n;
		}
		if (goP4 && treasure != 4) wp[n++] = P4;
		if (goP3 && treasure != 3) wp[n++] = P3;
		return n;
	}

	/* 全跑：宝物=4 按沿途岔口重排 S2 -> P3 -> S1；其余基础序 */
	if (treasure == 4) {
		if (goP4 && UPRIGHT_TOUR_ENABLE) wp[n++] = S2;
		if (goP3 && treasure != 3)       wp[n++] = P3;
		if (goP3 && UPRIGHT_TOUR_ENABLE) wp[n++] = S1;
		return n;
	}
	if (goP3 && treasure != 3)       wp[n++] = P3;
	if (goP3 && UPRIGHT_TOUR_ENABLE) wp[n++] = S1;
	if (goP4 && treasure != 4)       wp[n++] = P4;
	if (goP4 && UPRIGHT_TOUR_ENABLE) wp[n++] = S2;
	return n;
}

#if USE_PLANNER_ROUTE
/**
 * @brief P7/P8 得到宝物编号后规划回程（含宝物平台）
 * @param start 起点（P7 或 P8）
 * @return 1=成功, 0=失败
 */
static uint8_t plan_treasure_return(uint8_t start)
{
	u8 wp[10];   /* 补打卡 + 巡回交错后最多 9 个点（start + P5/P6 + 门×2 + 宝物平台 + P3 + S1 + P4 + S2 + P2），10 够 */
	uint8_t n = 0;
	uint8_t target;
	u8 exit_node;                /* 出门节点：门区最后加的节点（宝物平台加在它后面，别拿 wp[n-1] 判） */

	switch (treasure)
	{
	case 2: target = P1; break;
	case 3: target = P3; break;
	case 4: target = P4; break;
	case 5: target = P5; break;
	case 6: target = P6; break;
	default:
		printf("[HARD-STOP] mp:plan_treasure_return treasure id invalid\r\n");
		CarBrake_Stop();
		return 0;
	}

	wp[n++] = start;

	/* 特殊平台处理：P5 是 N13 支路，P6 经 N7/N9 支路（跷跷板单向由图约束）*/
	if (treasure == 5)
	{
		wp[n++] = P5;
	}
	else if (treasure == 6)
	{
		wp[n++] = P6;
	}

	/* 根据门状态选择回程路径
	 * ⚠️ N12 只在 D2 分支当必经点：D2 的门是 N5<->N12，而规划层看不见门颜色，
	 *    只能靠必经点把车赶到 D2 门口。D3/D4 分支的门在 N8 上，wp 已钉死 N8，
	 *    再加 N12 纯属绕路（实测多 170cm，且会经过 N10->N11 刀山）。 */
	if (door_pass[0] == CAN_PASS)
	{
		wp[n++] = N12;
		wp[n++] = N5;
	}
	else if (door_pass[1] == CAN_PASS)
	{
		wp[n++] = N8;
		wp[n++] = N5;
	}
	else if (door_pass[2] == CAN_PASS)
	{
		wp[n++] = N8;
		wp[n++] = N3;
	}
	else if (door_pass[0] == ONE_WAY_PASS || door_pass[1] == ONE_WAY_PASS ||
		door_pass[2] == ONE_WAY_PASS)
	{
		/* 回程需经 D5；该门仍由 door() 在 N10->N3 上读取和处理 */
		wp[n++] = N10;
		wp[n++] = N3;
	}
	else
	{
		printf("[HARD-STOP] mp:plan_treasure_return no door passable\r\n");
		CarBrake_Stop();
		return 0;
	}

	exit_node = wp[n - 1];        /* 出门节点：N3 或 N5（门区最后加的节点） */

	/* 添加非特殊平台的宝物目标 */
	if (treasure != 5 && treasure != 6)
		wp[n++] = target;

	/* 一轮回程：宝物平台之后，交错安排"补打卡 P3/P4"与"直立景点 S1/S2 巡回"。
	 * 判据与顺序见 append_round1_return_tail()（S1/S2 不再依赖宝物值；宝物=4 时尾段按沿途岔口重排 S2 -> P3 -> S1，景点也全在宝物后）。 */
	/* 尾段预案恒为全量（TB_ALL）：到达 N3/N5 时由
	 * round1_exit_recheck() 用真实已用时重定档（时间预算总开关 TIME_BUDGET_ENABLE）。 */
	n = append_round1_return_tail(wp, n, TB_ALL, (exit_node == N3));
	wp[n++] = P2;

	/* 交接（stageAB 段不再写尾锚点 C9/N20 后必须做）：
	 * 本函数只在宝物平台上被调用，而 stageAB 段现在以平台本身为终点。
	 * 到达平台那一刻 nodes.nextNode 会停在"进平台那条边"，若不修正：
	 *   ① 推进时 nodes.nowNode = nodes.nextNode 会错位 → 下一步 getNextConnectNode 找不到边 → Route_Error_Stop 死停车；
	 *   ② Stage_Correct() 拿 nodes.nextNode.angle 当行驶航向，会反向 180°。
	 * 所以这里显式把 nextNode 对齐到"出平台第一跳"（= 本段重规划后的第一个目标）。
	 * 证据：scripts/validate/_check_wp_east.py + 状态机仿真（删尾锚点不补交接 = 4/4 场次死停车）。 */
	if (plan_route_at(map.point - 1, wp, n) == 0)
		return 0;
	if (map.point > 0)
	{
		u8 first = route[map.point - 1];
		if (first != 0xFF)
			nodes.nextNode = Node[getNextConnectNode(start, first)];
	}
	return 1;
}
#endif

/**
 * @brief 判断门是否可通行（CAN_PASS 或 ONE_WAY_PASS）
 */
static uint8_t Can_Pass(uint8_t c)
{
	return c == CAN_PASS || c == ONE_WAY_PASS;
}

/**
 * @brief 拼接第二轮路线（pre + entry + tour + tail）
 * @note  仅 USE_PLANNER_ROUTE=0 的手工兜底分支使用，=1 时不参与编译
 */
#if !USE_PLANNER_ROUTE
static void build_round2_route(const u8 *pre, const u8 *entry, const u8 *tour, const u8 *tail)
{
	uint8_t i, n = 0;
	for (i = 0; pre[i] != 0XFF; i++)	route[n++] = pre[i];
	for (i = 0; entry[i] != 0XFF; i++)	route[n++] = entry[i];
	for (i = 0; tour[i] != 0XFF; i++)	route[n++] = tour[i];
	for (i = 0; tail[i] != 0XFF; i++)	route[n++] = tail[i];
	route[n] = 0XFF;
}
#endif /* !USE_PLANNER_ROUTE */

/* ==================== 公共 API 实现 ==================== */

void update_route_at_P1(void)
{
	if(flag_line_clue == 3)
	{
		const u8 r[] = {B1, N1, P1, N1, B2, N4, N3, P3, N3, N4, N5, N12, 0XFF};
		load_route_at(0, r);
	}
	else if(flag_line_clue == 4)
	{
		const u8 r[] = {B1, N1, P1, N1, B2, N4, N5, N6, P4, N6, N5, N12, 0XFF};
		load_route_at(0, r);
	}
	else if(flag_line_clue == 0)
	{
		// 跳过 P3/P4，直接去门区
		const u8 r[] = {B1, N1, P1, N1, B2, N4, N5, N12, 0XFF};
		load_route_at(0, r);
	}
}

/* ==================== 门回程：规划层方案（替代原来的 12 条手写穷举） ====================
 * 原理：回程之所以原先要写死路线，是因为"规划器不知道哪扇门此刻不能走"，会穿门/在门口掉头。
 *       现在先把【整个门区 8 条边】在规划层禁用（门区是单向/禁行约束的集中地，回程不再进去），
 *       再用一句 wp={当前节点,[宝物平台],P2} 让最短路自己算回家路。
 * 例外：door_2 那一种情形（D5 黑、D3 蓝已用尽）必须从 N8 经 D4 退回 N3 重读 D4，
 *       所以额外放行 N8→N3 —— 这是这条路上唯一允许穿的门。
 * 等价性：12 种 (入口 × 宝物) 组合已由 scripts/validate/_check_door_perm.py 证明与
 *         改造前的手写穷举路线逐字一致（golden 取自改造前的 git 快照）。
 * ================================================================================ */

/* 门区 8 条边全部设为"规划时不可通行" */
static void door_block_all(void)
{
	for (u8 i = 0; i < 8; i++)
		nav_set_edge_blocked(door_zone[i][0], door_zone[i][1], 1);
}

/**
 * @brief 门回程：封闭门区后，用最短路从当前(内侧)节点回家（必要时先绕去宝物平台）
 * @param allow_N8_N3 1=额外放行 N8→N3（door_2：退回去重读 D4）
 */
static void route_return_home(uint8_t allow_N8_N3)
{
	u8 wp[8];   /* ⚠️ 原为 wp[3]：插直立景点 + 补打卡交错后最多 7 个点 —— 留到 8 */
	uint8_t n = 0;
	u8 exit_node;

	door_block_all();
	if (allow_N8_N3)
		nav_set_edge_blocked(N8, N3, 0);

	exit_node = nodes.nowNode.nodenum;    /* 出门节点：door_retreat/door_set_pass_node 置为 N3 / N8 / N5 */
	wp[n++] = nodes.nowNode.nodenum;
	if (treasure == 2)       wp[n++] = P1;
	else if (treasure == 3)  wp[n++] = P3;
	else if (treasure == 4)  wp[n++] = P4;
	/* 宝物在 P5/P6 时本轮已到过，回程直接回家 */
	/* 一轮回程：补打卡 P3/P4 + 直立景点 S1/S2 交错，判据与顺序同 plan_treasure_return()。
	 * ⚠️ 两处都要插：回程过门时 door() 会重规划后半段，与本函数各管一段；
	 *    若该门边去程已被 door_set_pass_node() 改成 func=NONE，则不进 door()，只有本函数生效。 */
	/* 尾段预案恒为全量：到达 N3/N5 时由 round1_exit_recheck() 重定档 */
	n = append_round1_return_tail(wp, n, TB_ALL, (exit_node == N3));
	wp[n++] = P2;

	(void)plan_route_at(0, wp, n);
}

void update_route_by_door_1(void)
{
	route_return_home(0);      /* D5 绿：nowNode 已到 N3 */
}

void update_route_by_door_2(void)
{
	route_return_home(1);      /* D5 黑 + D3 蓝：nowNode 退到 N8，须经 D4 退回 N3 重读 D4 */
}

void update_route_by_door_3(void)
{
	route_return_home(0);      /* D4 回程绿：nowNode 已到 N3 */
}

void update_route_by_door_4(void)
{
	route_return_home(0);      /* D4 回程黑：nowNode 退到 N5 */
}

void update_route_at_door_for_stageAB(void)
{
#if USE_PLANNER_ROUTE
	/* 过门后只要 P 平台本身：环上节点、以及平台出口锚点(C9/N20)全部交给最短路自动选。
	 * 平台出口锚点原先靠"路线里还有下一跳"给 nodes.nextNode 兜底；现在改成
	 * plan_treasure_return() 里显式把 nextNode 对齐到"出平台第一跳"（见该函数注释）。 */
	if (flag_clue_stage_A == 5 && flag_clue_stage_B == 7)
	{
		u8 wp[] = {nodes.nowNode.nodenum, P5, P7};
		(void)plan_route_at(0, wp, sizeof(wp) / sizeof(wp[0]));
	}
	else if (flag_clue_stage_A == 5 && flag_clue_stage_B == 8)
	{
		u8 wp[] = {nodes.nowNode.nodenum, P5, P8};
		(void)plan_route_at(0, wp, sizeof(wp) / sizeof(wp[0]));
	}
	else if (flag_clue_stage_A == 6 && flag_clue_stage_B == 7)
	{
		u8 wp[] = {nodes.nowNode.nodenum, P6, P7};
		(void)plan_route_at(0, wp, sizeof(wp) / sizeof(wp[0]));
	}
	else if (flag_clue_stage_A == 6 && flag_clue_stage_B == 8)
	{
		u8 wp[] = {nodes.nowNode.nodenum, P6, P8};
		(void)plan_route_at(0, wp, sizeof(wp) / sizeof(wp[0]));
	}
	else
	{
		printf("[HARD-STOP] mp:update_route_at_P7_* clue combo unmatched\r\n");
		CarBrake_Stop();
	}
	return;
#endif
#if !USE_PLANNER_ROUTE
	/* ⚠️ 以下 USE_PLANNER_ROUTE=0 的手工兜底分支暂时不参与编译：
	   rout_57/58/67/68 已从 map.c 删除（改由规划器动态生成），切回 0 前需先恢复这些路线数组 */
	// 按线索平台组合选择路线
	if (flag_clue_stage_A == 5 && flag_clue_stage_B == 7)
	{
		if(Can_Pass(door_pass[0]))
			load_route_at(0, rout_57);
		else if(Can_Pass(door_pass[1]) || Can_Pass(door_pass[2]))
		{
			route[0] = N12;
			load_route_at(1, rout_57);
		}
	}
	else if (flag_clue_stage_A == 5 && flag_clue_stage_B == 8)
	{
		if(Can_Pass(door_pass[0]))
			load_route_at(0, rout_58);
		else if(Can_Pass(door_pass[1]) || Can_Pass(door_pass[2]))
		{
			route[0] = N12;
			load_route_at(1, rout_58);
		}
	}
	else if (flag_clue_stage_A == 6 && flag_clue_stage_B == 7)
	{
		if(Can_Pass(door_pass[0]))
		{
			route[0] = N11;
			route[1] = N10;
			load_route_at(2, rout_67);
		}
		else if(Can_Pass(door_pass[1]) || Can_Pass(door_pass[2]))
		{
			route[0] = N10;
			load_route_at(1, rout_67);
		}
	}
	else if (flag_clue_stage_A == 6 && flag_clue_stage_B == 8)
	{
		if(Can_Pass(door_pass[0]))
		{
			route[0] = N11;
			route[1] = N10;
			load_route_at(2, rout_68);
		}
		else if(Can_Pass(door_pass[1]) || Can_Pass(door_pass[2]))
		{
			route[0] = N10;
			load_route_at(1, rout_68);
		}
	}
#endif /* !USE_PLANNER_ROUTE */
}

void update_route_at_P7_for_treasure(void)
{
#if USE_PLANNER_ROUTE
	(void)plan_treasure_return(P7);
#endif
	/* USE_PLANNER_ROUTE=0 时的手工路线已注释（见 barrier.c 原始版本）*/
}

void update_route_at_P8_for_treasure(void)
{
#if USE_PLANNER_ROUTE
	printf("treasure%d\r\n",treasure);
	(void)plan_treasure_return(P8);
#endif
	/* USE_PLANNER_ROUTE=0 时的手工路线已注释（见 barrier.c 原始版本）*/
}

void Clear_door(void)
{
	nav_clear_blocked();    /* 规划层同步放行：二轮起所有门区边恢复可通行 */
	door_set_pass_node(N5, N12, DOOR_LEN_N5N12, SPEED4);
	door_set_pass_node(N12, N5, DOOR_LEN_N5N12, SPEED4);
	door_set_pass_node(N5, N8, DOOR_LEN_N5N8, SPEED4);
	door_set_pass_node(N8, N5, DOOR_LEN_N5N8, SPEED4);
	door_set_pass_node(N3, N8, DOOR_LEN_N3N8, SPEED4);
	door_set_pass_node(N8, N3, DOOR_LEN_N3N8, SPEED4);
	door_set_pass_node(N3, N10, DOOR_LEN_N3N10, SPEED4);
	door_set_pass_node(N10, N3, DOOR_LEN_N3N10, SPEED4);
}

void get_newroute(void)
{
	extern void mapInit(void);  /* 前向声明 */
	Match_Timer_Start();   /* 二轮自己的 180s：重置本轮计时（2026-10-11） */
	s_exit_checked = 0;    /* 二轮复位出门定档检查站 */
	s_home_forced = 0;     /* 二轮复位硬截止接管标志 */

	const u8 r[] = {B1, N1, P1, 0XFF};
	load_route_at(0, r);
	mapInit();
	// 全部放行通行
	Clear_door();
	//重置直立景点
	upright_Set();
#if USE_PLANNER_ROUTE
	{
		u8 wp[24];
		uint8_t n = 0;
		/* 第二轮巡游顺序（CW = 宝物!=6 / CCW = 宝物==6）：来自 config.h 的 ROUND2_CRUISE_*
		 * —— 上位机「二轮路线…」可读写；两组填成一样即与宝物值无关。 */
		const u8 cruise_cw[4]  = {ROUND2_CRUISE_CW_1,  ROUND2_CRUISE_CW_2,
		                          ROUND2_CRUISE_CW_3,  ROUND2_CRUISE_CW_4};
		const u8 cruise_ccw[4] = {ROUND2_CRUISE_CCW_1, ROUND2_CRUISE_CCW_2,
		                          ROUND2_CRUISE_CCW_3, ROUND2_CRUISE_CCW_4};
		const u8 *cruise = (treasure == 6) ? cruise_ccw : cruise_cw;
		uint8_t p6_first = (cruise[0] == P6);   /* 首站=P6（逆时针）⇒ 过 D4 后两个门节点都保留 */

		/* 第一轮已回到 P2；第二轮固定完成 P1/P3/P4，再按门状态进入东区 */
		wp[n++] = N2;
		wp[n++] = P1;
		wp[n++] = P3;
		if (UPRIGHT_TOUR_ENABLE && ROUND2_S1_ENABLE) wp[n++] = S1;   /* 二轮绕 S1（N3 支路，往返 518cm）；ROUND2_S1_ENABLE（config.h）可单独关 */
		wp[n++] = P4;
		if (UPRIGHT_TOUR_ENABLE) wp[n++] = S2;   /* 二轮固定绕 S2（N6 支路，往返 288cm） */
		wp[n++] = N5;

		/* 进门：只留"真正要过的那扇门"；环上入口(N8 之后的 N12、N3 之后的 N8)由最短路自动选
		 * ——实测与写全 N 锚点逐字节相同，见 scripts/validate/_check_wp_east.py */
		if (Can_Pass(door_pass[0]))
		{
			wp[n++] = N12;
		}
		else if (Can_Pass(door_pass[1]))
		{
			wp[n++] = N8;
		}
		else if (Can_Pass(door_pass[2]))
		{
			wp[n++] = N3;
			if (p6_first) wp[n++] = N8;   /* 巡游首站=P6（逆时针）时，这两个门节点都要保留 */
		}
		else
		{
			printf("[HARD-STOP] mp:return combo unmatched\r\n");
			CarBrake_Stop();
			return;
		}

		/* 巡游：只写 P5~P8，顺序由 cruise[] 决定（其余 N 全部交给最短路） */
		wp[n++] = cruise[0];
		wp[n++] = cruise[1];
		wp[n++] = cruise[2];
		wp[n++] = cruise[3];

		/* 回程：只留"要过的那扇门"；⚠️ N8,N5 里的 N5 必须保留
		 * （删掉后规划器会改走 N8->N3 穿 D4 出西侧，实测路线会变） */
		if (door_pass[0] == CAN_PASS)
		{
			wp[n++] = N5;
		}
		else if (door_pass[0] == ONE_WAY_PASS && door_pass[3] == CAN_PASS)
		{
			wp[n++] = N10;               /* 原 N10,N3：N3 冗余 */
		}
		else if (door_pass[0] == ONE_WAY_PASS && door_pass[3] == NO_PASS && door_pass[2] == CAN_PASS)
		{
			wp[n++] = N8;                /* 原 N8,N3：N3 冗余 */
		}
		else if (door_pass[0] == ONE_WAY_PASS && door_pass[3] == NO_PASS && door_pass[2] == NO_PASS)
		{
			wp[n++] = N8;
			wp[n++] = N5;                /* ⚠️ 不可删 */
		}
		else if (door_pass[0] == NO_PASS && door_pass[1] == CAN_PASS)
		{
			wp[n++] = N8;
			wp[n++] = N5;                /* ⚠️ 不可删 */
		}
		else if (door_pass[0] == NO_PASS && door_pass[1] == ONE_WAY_PASS && door_pass[3] == CAN_PASS)
		{
			wp[n++] = N10;               /* 原 N10,N3：N3 冗余 */
		}
		else if (door_pass[0] == NO_PASS && door_pass[1] == ONE_WAY_PASS && door_pass[3] == NO_PASS)
		{
			wp[n++] = N8;                /* 原 N8,N3：N3 冗余 */
		}
		else if (door_pass[0] == NO_PASS && door_pass[1] == NO_PASS && door_pass[2] == CAN_PASS)
		{
			wp[n++] = N8;                /* 原 N8,N3：N3 冗余 */
		}
		else if (door_pass[0] == NO_PASS && door_pass[1] == NO_PASS && door_pass[2] == ONE_WAY_PASS)
		{
			wp[n++] = N10;               /* 原 N10,N3：N3 冗余 */
		}
		else
		{
			printf("[HARD-STOP] mp:round1 return combo unmatched\r\n");
			CarBrake_Stop();
			return;
		}

		wp[n++] = P2;
		(void)plan_route_at(0, wp, n);
		return;
	}
#endif

#if !USE_PLANNER_ROUTE
	/* USE_PLANNER_ROUTE=0 时的手工拼接路线（兜底）：数组都在本文件内，不依赖已删除的 rout_*。
	 * ⚠️ config.h 的 ROUND2_CRUISE_* 巡游顺序宏**只在 USE_PLANNER_ROUTE=1 分支生效**（这里写死）。 */
	// 公共段：P1→P3→P4（到N5岔口）
	const u8 pre[]  = {B1,N1,P1,N1,B2,N4,N3,P3,N3,N4,N5,N6,P4,N6,N5,0XFF};
	// 东区巡游：P5→P7→P8→P6
	const u8 tour[] = {N13,P5,N13,N12,N16,N18,B5,N19,C6,B7,N22,C9,P7,C9,N22,B6,N20,P8,N20,C4,B11,C8,C7,B10,N14,C3,N9,B9,N7,P6,N7,B8,N9,N10,0XFF};
	// 宝藏=P6：先深入去P6，再P8→P7→P5绕回（终点改为N12，避开N11刀山）
	const u8 tour_p6[] = {N9,B9,N7,P6,N7,B8,N9,C3,N14,B10,C7,C8,B11,C4,N20,P8,N20,B6,N22,C9,P7,C9,N22,B7,C6,N19,B5,N18,N16,N12,N13,P5,N13,N12,0XFF};
	const u8 *use_tour = (treasure == 6) ? tour_p6 : tour;

	// 进东区路径选择（根据门状态和宝物位置）
	const u8 entry_D2_p6[]   = {N12,N11,N10,0XFF};
	const u8 entry_D2[]      = {N12,0XFF};
	const u8 entry_D3_p6[]   = {N8,N10,0XFF};
	const u8 entry_D3[]      = {N8,N12,0XFF};
	const u8 entry_far_p6[]  = {N4,N3,N8,N10,0XFF};
	const u8 entry_far[]     = {N4,N3,N8,N12,0XFF};
	const u8 *use_entry_D2  = (treasure == 6) ? entry_D2_p6  : entry_D2;
	const u8 *use_entry_D3  = (treasure == 6) ? entry_D3_p6  : entry_D3;
	const u8 *use_entry_far = (treasure == 6) ? entry_far_p6 : entry_far;

	// 出东区回家路径（根据门状态）
	const u8 tail_D2[] = {N5,N4,B3,N2,P2,0XFF};
	const u8 tail_D3[] = {N8,N5,N4,B3,N2,P2,0XFF};
	const u8 tail_D3_D5_blue[] = {N10,N3,N4,B3,N2,P2,0XFF};
	const u8 tail_far[] = {N3,N4,B3,N2,P2,0XFF};

	// 根据门状态组装完整路线
	if (door_pass[0] == CAN_PASS)
	{
		build_round2_route(pre, use_entry_D2, use_tour, tail_D2);
	}
	else if (door_pass[1] == CAN_PASS)
	{
		build_round2_route(pre, use_entry_D3, use_tour, tail_D3);
	}
	else if (door_pass[2] == CAN_PASS)
	{
		build_round2_route(pre, use_entry_far, use_tour, tail_far);
	}
	else if ((door_pass[0] == ONE_WAY_PASS || door_pass[1] == ONE_WAY_PASS) &&
		door_pass[3] == NO_PASS)
	{
		build_round2_route(pre, use_entry_D3, use_tour, tail_D3);
	}
	else if ((door_pass[0] == ONE_WAY_PASS || door_pass[1] == ONE_WAY_PASS) &&
		door_pass[3] == CAN_PASS)
	{
		build_round2_route(pre, use_entry_far, use_tour, tail_D3_D5_blue);
	}
	else if (door_pass[2] == ONE_WAY_PASS && door_pass[3] == CAN_PASS)
	{
		build_round2_route(pre, use_entry_far, use_tour, tail_D3_D5_blue);
	}
	else if (door_pass[2] == ONE_WAY_PASS && door_pass[3] == NO_PASS)
	{
		build_round2_route(pre, use_entry_far, use_tour, tail_far);
	}
	else
	{
		printf("[HARD-STOP] mp:round2 combo unmatched\r\n");
		CarBrake_Stop();
	}
#endif /* !USE_PLANNER_ROUTE */
}
