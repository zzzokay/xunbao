/* 编译期检查：NavEdgeTbl 行数必须与 NAV_EDGE_COUNT 一致（改漏立即编译报错）
   使用 C99 兼容技巧：负数组大小在编译期报错 */
typedef char NavEdgeTbl_size_check[(sizeof(NavEdgeTbl)/sizeof(NavEdge) == NAV_EDGE_COUNT) ? 1 : -1];

